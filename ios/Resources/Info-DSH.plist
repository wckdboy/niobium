<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Niobium</string>
	<key>CFBundleName</key>
	<string>Niobium</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>Main App</string>
					<key>UISceneDelegateClassName</key>
					<string>NiobiumSceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchMark</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<false/>
	</dict>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Niobium runs the DeepSeek Harness web UI on loopback and can connect to your self-hosted Hermes gateway.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Attach images to messages for your Hermes agents.</string>
	<key>NSCameraUsageDescription</key>
	<string>Take a photo to send to your Hermes agents.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Dictate messages to your Hermes agents.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Turn your voice into messages for your Hermes agents.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>DSH lets the agent read your calendar when you turn the Calendar capability on.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>DSH lets the agent read your calendar when you turn the Calendar capability on.</string>
	<key>NSContactsUsageDescription</key>
	<string>DSH looks up contacts by name when you ask the agent about someone, and only after you switch Contacts on.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>DSH can read your Health data only after you switch Apple Health on.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>DSH never writes to Apple Health. This description is required because the app links HealthKit.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>DSH asks for your location only when the agent needs it for something you asked.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>DSH lets the agent read your reminders when you turn the Reminders capability on.</string>
	<key>NSRemindersUsageDescription</key>
	<string>DSH lets the agent read your reminders when you turn the Reminders capability on.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>DSH uses your location only while you are using the app, when the agent needs it.</string>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UIRequiresFullScreen</key>
	<false/>
</dict>
</plist>
